DATABASE_URL=postgresql://myuser:mysecretpassword@localhost:5432/authservice

JWT_SECRET=replace-with-a-long-random-secret

REDIS_URL=redis://localhost:6379

FALLBACK_URL=http://localhost:3000

PORT=3000

DOMAIN=authservice.com

# Public demo safety. Set to false only for a trusted, non-public deployment.
DEMO_MODE=true

# Starts the two built-in dummy backends inside the main process.
ENABLE_DEMO_BACKENDS=true
DEMO_ORDERS_PORT=3001
DEMO_INVENTORY_PORT=3002
